# Telegram bot token from @BotFather
BOT_TOKEN=your_telegram_bot_token

# Telegram ID of the administrator (comma-separated IDs are supported)
ADMIN_ID=your_telegram_numeric_user_id

# Supabase project URL and server-only service role/secret key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Optional fallback card details for manual PRO payments
PAYMENT_CARD=
PAYMENT_CARD_HOLDER=

# Shared secret used only for bot-to-backend requests
BOT_INTERNAL_SECRET=generate_a_long_random_secret

# Public HTTPS backend URL used by the bot and index.html's api-base-url; use http://localhost:3000 locally
BACKEND_URL=https://your-backend.example.com

# Public HTTPS Telegram Web App URL
WEBAPP_URL=https://your-webapp.example.com/

# Optional: set when the Web App is hosted on a different domain from the API.
# Multiple allowed origins can be comma-separated.
APP_ORIGIN=https://your-webapp.example.com

# Google Gemini API key; required when using the AI assistant
AI_API_KEY=your_gemini_api_key

# Optional Gemini model (defaults to gemini-3.6-flash; retired 1.5 models use this fallback)
AI_MODEL=gemini-3.6-flash

# Optional server port (defaults to 3000 if the host does not supply PORT)
PORT=3000
